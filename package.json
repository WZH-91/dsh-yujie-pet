{
  "name": "dsh-yujie-pet",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "assets/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "description": "带派桌宠: DSH 桌面宠物,每轮回复结束喊一句「带派不,老铁」。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "desktop-pet",
    "voice",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/WZH-91/dsh-yujie-pet.git"
  },
  "homepage": "https://github.com/WZH-91/dsh-yujie-pet#readme"
}
